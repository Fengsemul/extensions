{  "manifest_version": 3,  "name": "Googless",  "version": "2.1.0",  "description": "Detects Google websites and Google services embedded in webpages.",  "permissions": [    "storage",    "tabs"  ],  "host_permissions": [    "<all_urls>"  ],  "background": {    "scripts": [      "background.js"    ]  },  "action": {    "default_icon": {      "48": "icons/googless-48.png"    },    "default_title": "Googless",    "default_popup": "popup.html"  },  "icons": {    "48": "icons/googless-48.png"  },  "content_scripts": [    {      "matches": [        "<all_urls>"      ],      "js": [        "content.js"      ],      "css": [        "modal.css"      ],      "run_at": "document_start",      "all_frames": false    }  ],  "web_accessible_resources": [    {      "resources": [        "icons/*.svg",        "fonts/*.woff",        "fonts/*.ttf"      ],      "matches": [        "<all_urls>"      ]    }  ],  "browser_specific_settings": {    "gecko": {      "id": "googless@example.local",      "strict_min_version": "109.0"    }  }}
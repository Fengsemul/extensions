{
  "manifest_version": 2,
  "name": "Googless & GAFALink Hybrid",
  "version": "3.0.0",
  "description": "Blocks GAFAM/Google tracking, provides overlay coverage, tab status, and highlights proprietary links.",
  "permissions": [
    "storage",
    "tabs",
    "<all_urls>",
    "webRequest"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_icon": "icons/googless-48.png",
    "default_title": "Googless",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "googless-gafalink@local.addon",
      "strict_min_version": "109.0"
    }
  }
}
